# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic — used only for Stage 2 anomaly *explanations* (optional for a working demo)
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# Anomaly rule knobs (optional; defaults match the take-home spec)
ANOMALY_OFF_HOURS_TZ=America/New_York
ANOMALY_BUSINESS_START_HOUR=8
ANOMALY_BUSINESS_END_HOUR=18
ANOMALY_RATE_THRESHOLD=20
ANOMALY_RATE_WINDOW_SECONDS=60
ANOMALY_TRANSFER_MEDIAN_MULTIPLIER=10
ANOMALY_TRANSFER_FLOOR_BYTES=5242880
